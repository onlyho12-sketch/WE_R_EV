<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".PleosConnectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 르르링 앱의 '위젯 설정'이 보내는 애니메이션 설정 (명시적 broadcast, setPackage) -->
        <receiver
            android:name=".WidgetSettingsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.pleosconnect.action.WIDGET_SETTINGS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
