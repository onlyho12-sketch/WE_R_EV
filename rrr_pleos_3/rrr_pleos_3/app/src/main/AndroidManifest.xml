<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Pleos SDK (권한 이름은 SDK AAR 안의 상수에서 확인) -->
    <!-- Vehicle: 배터리 SOC·연료 읽기 / 충전 스위치·충전 한도 쓰기 / 주행 거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- NaviHelper: 목적지 수신 · 경유지 등록 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- TextToSpeech: 결정적 순간 1회 음성 안내 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Gleo/음성 입력: 음성인식 화면이 있는지 확인하기 위한 패키지 가시성 -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Pleos TTS 가 없는 기기에서 안드로이드 기본 TTS 엔진을 찾기 위함 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- WE'R Widget 설정 연동: Pleos Connect 시뮬레이터(:pleos_connect) 앱을 찾기 위한 패키지 가시성 -->
        <package android:name="com.example.pleosconnect" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RRR">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.RRR"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo AI App Schema의 Gleo Action이 호출하는 출발지/도착지 설정 (GleoBridge.kt) -->
            <intent-filter>
                <action android:name="com.example.rrr.action.SET_TRIP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>